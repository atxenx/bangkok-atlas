        PREP --> FEAT --> SCORE
    end

    subgraph D["03 · LOCAL STORAGE"]
        direction TB
        GEO[("🗄️ Spatial Store<br/>Parquet · GeoJSON<br/>Cells · Features · Scores")]
        META[("📁 Reference Store<br/>Treasury Index JSON<br/>Reference Layers · Map Assets")]
    end

    subgraph B["04 · BACKEND — FastAPI"]
        direction TB
        ANALYSIS["🔎 Location Analysis<br/>Quality Breakdown · Factors<br/>OSM Street-form Proxies"]
